module tb_radix8;
reg signed [7:0] A, B;
wire signed [15:0] PRODUCT;
booth_radix8_multiplier_8bit uut (
 .A(A),
 .B(B),
 .PRODUCT(PRODUCT)
);
initial 
begin
 A = 12; B = 5; #10;
 $display("A=%d, B=%d, PRODUCT=%d", A, B, PRODUCT);
 A = -12; B = 5; #10;
 $display("A=%d, B=%d, PRODUCT=%d", A, B, PRODUCT);
 A = 12; B = -5; #10;
 $display("A=%d, B=%d, PRODUCT=%d", A, B, PRODUCT);
 A = -12; B = -5; #10;
 $display("A=%d, B=%d, PRODUCT=%d", A, B, PRODUCT);
A = 7; B = 3; #10;
 $display("A=%d, B=%d, PRODUCT=%d", A, B, PRODUCT);
 $finish;
end
 endmodule
