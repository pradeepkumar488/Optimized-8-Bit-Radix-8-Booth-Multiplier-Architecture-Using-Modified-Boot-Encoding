module booth_radix8_multiplier_8bit(
    input signed [7:0] A,
    input signed [7:0] B,
    output reg signed [15:0] PRODUCT
);

reg signed [15:0] P;
reg signed [15:0] M;
reg signed [15:0] pp;
reg [8:0] Q_ext;
reg signed [3:0] code;
reg [3:0] bits;
integer i;

function signed [3:0] booth_op;
    input [3:0] b;
    begin
        case (b)
            4'b0000, 4'b1111: booth_op = 0;
            4'b0001, 4'b0010: booth_op = 1;
            4'b0011, 4'b0100: booth_op = 2;
            4'b0101, 4'b0110: booth_op = 3;
            4'b0111:          booth_op = 4;
            4'b1000:          booth_op = -4;
            4'b1001, 4'b1010: booth_op = -3;
            4'b1011, 4'b1100: booth_op = -2;
            4'b1101, 4'b1110: booth_op = -1;
            default: booth_op = 0;
        endcase
    end
endfunction

always @(*) begin
    P = 16'd0;
    M = A;
    Q_ext = {B, 1'b0};   // Append extra 0

    for (i = 0; i < 3; i = i + 1) begin
        bits = Q_ext[3*i +: 4];  // Take 4 bits
        code = booth_op(bits);
        pp = M * code;
        P = P + (pp <<< (3*i));
    end

    PRODUCT = P;
end
